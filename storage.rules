rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // 1. Gallery photographs
    // Public visitors can view memorial photographs
    match /gallery/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 2. Memorial portrait photographs
    match /portraits/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 3. Website memorial logos
    match /logos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default: public read, authenticated administrator write
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}

